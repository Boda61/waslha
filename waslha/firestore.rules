rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() {
      return request.auth != null;
    }
    function isMember(roomId) {
      return signedIn() && exists(
        /databases/$(database)/documents/rooms/$(roomId)/players/$(request.auth.uid)
      );
    }
    function isHost(roomId) {
      return signedIn() && get(
        /databases/$(database)/documents/rooms/$(roomId)
      ).data.hostId == request.auth.uid;
    }
    function roundStatus(roomId, roundId) {
      return get(
        /databases/$(database)/documents/rooms/$(roomId)/rounds/$(roundId)
      ).data.status;
    }
    function roundActiveTeam(roomId, roundId) {
      return get(
        /databases/$(database)/documents/rooms/$(roomId)/rounds/$(roundId)
      ).data.activeTeam;
    }
    function playerTeam(roomId) {
      return get(
        /databases/$(database)/documents/rooms/$(roomId)/players/$(request.auth.uid)
      ).data.team;
    }

    // ================= USERS =================
    // Profiles are created/updated only by Cloud Functions (Admin SDK bypasses rules).
    // Clients may read any authenticated user's public profile.
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Username index is managed only by Cloud Functions.
    match /usernames/{name} {
      allow read, write: if false;
    }

    // ================= CHALLENGES =================
    // Public challenge data (two images + 4 choices) is readable by members.
    match /challenges/{challengeId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // The protected correct-answer index is NEVER readable or writable by clients.
    match /challengeSecrets/{challengeId} {
      allow read, write: if false;
    }

    // Room codes lock docs — function-managed only.
    match /roomCodes/{code} {
      allow read, write: if false;
    }

    // ================= ROOMS =================
    match /rooms/{roomId} {
      // Only room members can read room state (scoreboard, status, winner).
      allow read: if isMember(roomId);
      // All state transitions (start, scoring, winner, rounds) go through functions.
      allow write: if false;

      // ---------- players ----------
      match /players/{uid} {
        allow read: if isMember(roomId);
        // A client may only touch its own `online` flag until it becomes offline.
        allow update: if isMember(roomId)
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['online']);
        allow create, delete: if false;
      }

      // ---------- rounds ----------
      match /rounds/{roundId} {
        allow read: if isMember(roomId);
        // Round transitions (clue, answer, reveal) are function-only.
        allow write: if false;

        // ---------- chat ----------
        match /messages/{messageId} {
          allow read: if isMember(roomId);
          // Only the ACTIVE team may post, and only after the clue is submitted.
          allow create: if isMember(roomId)
            && roundStatus(roomId, roundId) == 'clue_submitted'
            && playerTeam(roomId) == roundActiveTeam(roomId, roundId)
            && request.resource.data.senderId == request.auth.uid
            && request.resource.data.text.size() <= 200;
          allow update, delete: if false;
        }

        // ---------- predictions ----------
        match /predictions/{uid} {
          allow read: if isMember(roomId);
          // The OPPOSITE team may predict once, while answers are open.
          allow create: if isMember(roomId)
            && request.auth.uid == uid
            && roundStatus(roomId, roundId) == 'clue_submitted'
            && playerTeam(roomId) != roundActiveTeam(roomId, roundId)
            && !exists(/databases/$(database)/documents/rooms/$(roomId)/rounds/$(roundId)/predictions/$(uid))
            && request.resource.data.choiceIndex is int
            && request.resource.data.uid == request.auth.uid;
          allow update, delete: if false;
        }
      }
    }
  }
}
